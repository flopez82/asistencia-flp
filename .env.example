# ─── SERVIDOR ─────────────────────────────────
PORT=3000

# ─── SEGURIDAD ────────────────────────────────
# Cambia esto por una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-algo-muy-secreto-2024

# ─── BASE DE DATOS ────────────────────────────
# Ruta donde se guarda el archivo SQLite
DB_PATH=./asistencia.db

# ─── GMAIL ────────────────────────────────────
# Tu correo Gmail
GMAIL_USER=tucorreo@gmail.com

# Contraseña de aplicación de Google (NO tu contraseña normal)
# Cómo obtenerla: myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Correo donde llega el reporte diario (puede ser el mismo Gmail)
ADMIN_EMAIL=jefe@empresa.com

# ─── FISCALIZADOR ─────────────────────────────────────────────
# Clave para acceso de la Dirección del Trabajo (elige una clave segura)
# Ejemplo de URL: https://tu-servidor.com/api/fiscalizador?key=TU_CLAVE&mes=2026-05
FISCALIZADOR_KEY=clave-fiscalizador-segura-2024
